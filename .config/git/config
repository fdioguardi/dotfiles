	email = felipedioguardi@gmail.com
	name = Felipe Dioguardi
	signingkey = 190A167A9131CD1F129C07DDA1DD837CB54AF17C
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[core]
	pager = bat
	autocrlf = input
[alias]
	a = add
	b = branch
	ci = commit
	co = checkout
	g = grep --break --heading --line-number
	l = log --oneline -10 HEAD
	last = log -1 HEAD
	s = status
	ups = commit --amend
	us = restore --staged
[init]
	defaultBranch = main
[submodule]
	recurse = true
[fetch]
	prune = true
[grep]
	lineNumber = true
[commit]
	gpgSign = true
[tag]
	gpgSign = true
[gpg]
	program = gpg2
[credential]
	helper = cache
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[rebase]
	autoStash = true
	updateRefs = true
[branch]
	sort = -committerdate
